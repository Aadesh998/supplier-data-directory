# Server-side only: where the Go API is reachable from the Next.js server.
API_INTERNAL_URL=http://localhost:8080
# Public site origin used for canonical URLs, sitemap and robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Must be exactly "true" to allow search engine indexing (production only).
NEXT_PUBLIC_ALLOW_INDEXING=false
# Contact address shown on privacy/legal pages.
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@example.com

# Playwright e2e (full stack must be running)
E2E_BASE_URL=http://localhost:3000
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
