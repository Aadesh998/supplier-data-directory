// Cloudflare deployment: one Worker in front of two containers (Go API, Next.js web).
// Requires the Workers Paid plan and Docker running locally for `wrangler deploy`.
// Secrets are NOT stored here — set them with `wrangler secret put` (see docs/runbooks/cloudflare.md).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bharatmfg",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },

  "containers": [
    {
      "class_name": "ApiContainer",
      "image": "../api.Dockerfile",
      "image_build_context": "../..",
      "instance_type": "basic",
      "max_instances": 2
    },
    {
      "class_name": "WebContainer",
      "image": "../web.Dockerfile",
      "image_build_context": "../../apps/web",
      "instance_type": "basic",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "API", "class_name": "ApiContainer" },
      { "name": "WEB", "class_name": "WebContainer" }
    ]
  },
  // Serve on the apex domain once peoplvance.org is a zone in this Cloudflare account. Add
  // { "pattern": "www.peoplvance.org", "custom_domain": true } too and redirect www → apex with a
  // Redirect Rule so there is one canonical host.
  "routes": [{ "pattern": "peoplvance.org", "custom_domain": true }],

  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ApiContainer", "WebContainer"] }],

  // Every 5 minutes: discovery cycle (claims DISCOVERY_JOBS_PER_RUN jobs). Daily 03:17 UTC: maintenance.
  "triggers": { "crons": ["*/5 * * * *", "17 3 * * *"] },

  "vars": {
    // Your public origin. Before peoplvance.org is attached (routes below), use the workers.dev URL.
    "PUBLIC_SITE_URL": "https://peoplvance.org",
    "NEXT_PUBLIC_ALLOW_INDEXING": "false",
    "PRIVACY_EMAIL": "privacy@peoplvance.org",
    "CONTACT_EMAIL": "hello@peoplvance.org",
    "MAIL_FROM": "Peoplvance <no-reply@peoplvance.org>",
    "PRIVACY_NOTICE_VERSION": "2026-11-v1",
    // Schema holding the tables when the database is shared (Railway: "peoplvance_dir"). Empty = public.
    "DATABASE_SCHEMA": "peoplvance_dir",
    // Discovery runner
    "DISCOVERY_ENABLED": "false",
    "DISCOVERY_JOBS_PER_RUN": "4",
    "DISCOVERY_PROVIDERS": "osm_overpass",
    "OVERPASS_URL": "https://overpass-api.de/api/interpreter"
  }
}
