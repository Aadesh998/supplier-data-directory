# Copy to .env and adjust. Never commit .env. All permission defaults in the app are restrictive.

# --- runtime ---
# development | test | production
APP_ENV=development
HTTP_ADDR=:8080
# Host port for the API container (change if 8080 is taken on your machine).
API_PORT=8080
PUBLIC_SITE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Only true when the API is reachable solely through a trusted reverse proxy (web container / Caddy).
TRUST_PROXY_HEADERS=false
SESSION_TTL=12h
# forced true in production
COOKIE_SECURE=false
# bump when /privacy changes; the form must send the same value
PRIVACY_NOTICE_VERSION=2026-11-v1
# 365 days
REVERIFY_INTERVAL=8760h
MAX_UPLOAD_BYTES=10485760

# --- database ---
# Local Postgres container (compose) and the test suite. Tests create/drop databases here only.
LOCAL_PG_USER=bharatmfg
LOCAL_PG_PASSWORD=devpassword
LOCAL_PG_DB=bharatmfg
LOCAL_PG_PORT=5434
# The database the API uses when run on the host (make run, scripts/create-user.sh).
DATABASE_URL=postgres://bharatmfg:devpassword@localhost:5434/bharatmfg?sslmode=disable
# Optional: keep every table in one schema. Use this when the database is shared with other apps
# (migration history then lives in <schema>.goose_db_version, and `migrate reset` is refused).
DATABASE_SCHEMA=
# Optional: database for the API *container* (docker compose). Empty = the local container.
# To run the containers against a remote database:  API_DATABASE_URL=${DATABASE_URL}
API_DATABASE_URL=

# --- secrets (generate; never reuse the dev defaults) ---
# 32 random bytes, base64:  openssl rand -base64 32
# Losing this key makes encrypted contact/submitter data unreadable. Back it up separately from DB backups.
DATA_ENCRYPTION_KEY=

# Shared secret so the web server's own server-side API calls are not rate-limited as one IP.
# openssl rand -hex 32   (leave empty locally to disable the bypass)
INTERNAL_API_TOKEN=
# Bearer token for discovery job workers (Cloudflare cron runner or your own). Empty disables /api/v1/worker/*.
# openssl rand -hex 32
WORKER_TOKEN=

# --- email (optional; without SMTP_HOST emails are only logged, without recipients) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=Peoplvance <no-reply@example.com>
ADMIN_NOTIFY_EMAIL=

# --- Google Places discovery (disabled by default; read docs/data-source-policy.md first) ---
GOOGLE_PLACES_ENABLED=false
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_DAILY_CAP=100

# --- web ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ALLOW_INDEXING=false
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@example.com
# Buyer enquiries / full-profile requests (defaults to the privacy inbox)
NEXT_PUBLIC_CONTACT_EMAIL=
