# Server env for the EC2 box. Copy to .env.production in the repo root (git-ignored),
# fill it in, then `make ec2-env`. It lands at /home/ubuntu/peoplvance/.env (chmod 600).
# HTTP_ADDR, TRUST_PROXY_HEADERS and GMAPS_API_URL are set by the systemd units.
APP_ENV=production
DATABASE_URL=
DATABASE_SCHEMA=peoplvance_dir
# SAME key as your current .env - a new key makes stored contacts unreadable. Back it up.
DATA_ENCRYPTION_KEY=
# openssl rand -hex 32
INTERNAL_API_TOKEN=
WORKER_TOKEN=

PUBLIC_SITE_URL=https://peoplvance.org
# The website's origin(s), comma-separated.
CORS_ALLOWED_ORIGINS=https://peoplvance.org
COOKIE_SECURE=true
PRIVACY_NOTICE_VERSION=2026-11-v1

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=Peoplvance <no-reply@peoplvance.org>
ADMIN_NOTIFY_EMAIL=

# Google Maps worker
GMAPS_DEPTH=5
GMAPS_EMAIL=false
GMAPS_IDLE_SECONDS=300
