[Unit]
Description=Peoplvance API
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/peoplvance
EnvironmentFile=/home/ubuntu/peoplvance/.env
# nginx (peoplvance.org/api/) and the website are the only clients; never listen publicly.
# Set via env(1), not Environment=, because values in EnvironmentFile would override Environment=.
ExecStart=/usr/bin/env HTTP_ADDR=127.0.0.1:8090 TRUST_PROXY_HEADERS=true /home/ubuntu/peoplvance/peoplvance-api serve
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
# Small box (1 GB) shared with the scraper and santimentos.
MemoryMax=300M
LimitNOFILE=65536
StandardOutput=append:/home/ubuntu/peoplvance/api.log
StandardError=append:/home/ubuntu/peoplvance/api.log

[Install]
WantedBy=multi-user.target
