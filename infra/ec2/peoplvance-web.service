[Unit]
Description=Peoplvance website (Next.js)
Wants=network-online.target
After=network-online.target peoplvance-api.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/peoplvance/web
# Same env file as the API: INTERNAL_API_TOKEN, NEXT_PUBLIC_* are read at runtime.
EnvironmentFile=/home/ubuntu/peoplvance/.env
# Set via env(1), not Environment=, because values in EnvironmentFile would override Environment=.
ExecStart=/usr/bin/env NODE_ENV=production PORT=3100 HOSTNAME=127.0.0.1 API_INTERNAL_URL=http://127.0.0.1:8090 NODE_OPTIONS=--max-old-space-size=256 /usr/bin/node /home/ubuntu/peoplvance/web/server.js
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20
MemoryMax=350M
StandardOutput=append:/home/ubuntu/peoplvance/web.log
StandardError=append:/home/ubuntu/peoplvance/web.log

[Install]
WantedBy=multi-user.target
